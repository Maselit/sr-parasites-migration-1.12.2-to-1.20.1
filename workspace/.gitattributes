# Normalize line endings to LF in the repository
* text=auto eol=lf

# Keep binary files as-is
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ogg binary
*.wav binary
*.mp3 binary
*.pdf binary
*.jar binary
*.class binary
*.zip binary
*.tar.gz binary
*.nbt binary
